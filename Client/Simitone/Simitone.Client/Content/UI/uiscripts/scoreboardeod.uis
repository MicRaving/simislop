# Scoreboard - Simitone EOD panel layout.
#
# Generated by Simitone.Client.UI.Panels.EODs.EODLayoutBuilder from the spec in
# EODLayouts.cs. Edit the spec, not this file: EODLayoutBuilderTests fails if the
# two disagree, so a hand edit here is a build failure rather than a silent drift.
#
# This is not an EA layout. The one the retail panel was written against is an
# artwork layout whose pictures live in a The Sims Online install, so the positions
# below are Simitone's own grid and the only picture any of these files names is
# the flat tile this port draws, uigraphics/eod/eod_placeholder.png.
#
# Captions come from Simitone's own string table (f900),
# so they are translatable rather than baked into this file.
#
# 19 controls, 5 rows, 4 columns.

<Begin>
    # Captions. f900 is Simitone's own UI string table
    # (Content/UI/uitext/<lang>.dir/_f900_simitone.cst), so these are
    # translatable rather than baked into this file.

    <Begin><SetSharedProperties stringDir = "UIText" stringTable = f900>
        <DefineString "str_black" stringIndex = 1016>
        <DefineString "str_blue" stringIndex = 1017>
        <DefineString "str_green" stringIndex = 1018>
        <DefineString "str_left_score" stringIndex = 1019>
        <DefineString "str_orange" stringIndex = 1020>
        <DefineString "str_purple" stringIndex = 1021>
        <DefineString "str_right_score" stringIndex = 1022>
        <DefineString "str_red" stringIndex = 1023>
        <DefineString "str_white" stringIndex = 1024>
        <DefineString "str_yellow" stringIndex = 1025>
        <DefineString "str_c280c9438" stringIndex = 1026>
        <DefineString "str_c2e0c9daa" stringIndex = 1027>
    <End>

    # Pictures. A Texture2D property can only be filled by a DefineImage node, and
    # the retail layouts fill them with TSO artwork ids. Every panel that has one
    # gets the same flat tile instead: enough for a control that asks a texture for its
    # size or its graphics device, and visibly a placeholder rather than a lie.

    <DefineImage "img_Scrollbar" assetID="uigraphics/eod/eod_placeholder.png">

    <AddButton "ColorBlack" position=(10,10) size=(92,20) text="str_black">
    <AddButton "ColorBlue" position=(114,10) size=(92,20) text="str_blue">
    <AddButton "ColorGreen" position=(218,10) size=(92,20) text="str_green">
    <AddButton "ColorLHS" position=(322,10) size=(92,20) text="str_left_score">
    <AddButton "ColorOrange" position=(10,40) size=(92,20) text="str_orange">
    <AddButton "ColorPurple" position=(114,40) size=(92,20) text="str_purple">
    <AddButton "ColorRHS" position=(218,40) size=(92,20) text="str_right_score">
    <AddButton "ColorRed" position=(322,40) size=(92,20) text="str_red">
    <SetControlProperties "ColorSelector" position=(10,70) size=(92,20)>
    <AddButton "ColorWhite" position=(114,70) size=(92,20) text="str_white">
    <AddButton "ColorYellow" position=(218,70) size=(92,20) text="str_yellow">
    <AddText "Loading" position=(322,70) font=10 size=(92,14)>
    <AddTextEdit "ScoreTextEntryLHS" position=(10,100) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddTextEdit "ScoreTextEntryRHS" position=(114,100) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddButton "SpinnerDecreaseLHS" position=(218,100) size=(92,20) text="str_c280c9438">
    <AddButton "SpinnerDecreaseRHS" position=(322,100) size=(92,20) text="str_c280c9438">
    <AddButton "SpinnerIncreaseLHS" position=(10,130) size=(92,20) text="str_c2e0c9daa">
    <AddButton "SpinnerIncreaseRHS" position=(114,130) size=(92,20) text="str_c2e0c9daa">
    <SetControlProperties "UIBackground" position=(218,130) size=(92,20)>

<End>
