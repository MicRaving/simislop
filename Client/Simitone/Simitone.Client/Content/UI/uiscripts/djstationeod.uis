# DJ Station - Simitone EOD panel layout.
#
# Generated by Simitone.Client.UI.Panels.EODs.EODLayoutBuilder from the spec in
# EODLayouts.cs. Edit the spec, not this file: EODLayoutBuilderTests fails if the
# two disagree, so a hand edit here is a build failure rather than a silent drift.
#
# This is not an EA layout. The one the retail panel was written against is an
# artwork layout whose pictures live in a The Sims Online install, so the positions
# below are Simitone's own grid and the only picture any of these files names is
# the flat tile this port draws, uigraphics/eod/eod_placeholder.png.
#
# Captions come from Simitone's own string table (f900),
# so they are translatable rather than baked into this file.
#
# 17 controls, 5 rows, 4 columns.

<Begin>
    # Pictures. A Texture2D property can only be filled by a DefineImage node, and
    # the retail layouts fill them with TSO artwork ids. Every panel that has one
    # gets the same flat tile instead: enough for a control that asks a texture for its
    # size or its graphics device, and visibly a placeholder rather than a lie.

    <DefineImage "img_DJRedImage" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_DJBlueImage" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_DJGreenImage" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_DJYellowImage" assetID="uigraphics/eod/eod_placeholder.png">

    <SetControlProperties "BassLabel" position=(10,10) size=(24,24)>
    <SetControlProperties "BassPanel" position=(114,10) size=(24,24)>
    <AddText "BassSample" position=(218,10) font=10 size=(92,14)>
    <SetControlProperties "BassText" position=(322,10) size=(24,24)>
    <SetControlProperties "DrumsLabel" position=(10,40) size=(24,24)>
    <SetControlProperties "DrumsPanel" position=(114,40) size=(24,24)>
    <AddText "DrumsSample" position=(218,40) font=10 size=(92,14)>
    <SetControlProperties "DrumsText" position=(322,40) size=(24,24)>
    <SetControlProperties "SynthLabel" position=(10,70) size=(24,24)>
    <SetControlProperties "SynthPanel" position=(114,70) size=(24,24)>
    <AddText "SynthSample" position=(218,70) font=10 size=(92,14)>
    <SetControlProperties "SynthText" position=(322,70) size=(24,24)>
    <SetControlProperties "TeamMedallion" position=(10,100) size=(92,20)>
    <SetControlProperties "VoxLabel" position=(114,100) size=(24,24)>
    <SetControlProperties "VoxPanel" position=(218,100) size=(24,24)>
    <AddText "VoxSample" position=(322,100) font=10 size=(92,14)>
    <SetControlProperties "VoxText" position=(10,130) size=(24,24)>

<End>
