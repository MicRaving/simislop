# Job Object Maze (logic) - Simitone EOD panel layout.
#
# Generated by Simitone.Client.UI.Panels.EODs.EODLayoutBuilder from the spec in
# EODLayouts.cs. Edit the spec, not this file: EODLayoutBuilderTests fails if the
# two disagree, so a hand edit here is a build failure rather than a silent drift.
#
# This is not an EA layout. The one the retail panel was written against is an
# artwork layout whose pictures live in a The Sims Online install, so the positions
# below are Simitone's own grid and the only picture any of these files names is
# the flat tile this port draws, uigraphics/eod/eod_placeholder.png.
#
# Captions come from Simitone's own string table (f900),
# so they are translatable rather than baked into this file.
#
# 14 controls, 4 rows, 4 columns.

<Begin>
    # Captions. f900 is Simitone's own UI string table
    # (Content/UI/uitext/<lang>.dir/_f900_simitone.cst), so these are
    # translatable rather than baked into this file.

    <Begin><SetSharedProperties stringDir = "UIText" stringTable = f900>
        <DefineString "str_east" stringIndex = 1085>
        <DefineString "str_north" stringIndex = 1086>
        <DefineString "str_south" stringIndex = 1087>
        <DefineString "str_west" stringIndex = 1088>
    <End>

    <SetControlProperties "BlueIcon" position=(10,10) size=(92,20)>
    <AddButton "East" position=(114,10) size=(92,20) text="str_east">
    <SetControlProperties "GreenIcon" position=(218,10) size=(92,20)>
    <SetControlProperties "HWall" position=(322,10) size=(92,20)>
    <AddButton "North" position=(10,40) size=(92,20) text="str_north">
    <AddText "PayoutCaption" position=(114,40) font=10 size=(92,14)>
    <AddText "PayoutField" position=(218,40) font=10 size=(92,14)>
    <SetControlProperties "RedIcon" position=(322,40) size=(92,20)>
    <AddButton "South" position=(10,70) size=(92,20) text="str_south">
    <SetControlProperties "UIPlayBackground" position=(114,70) size=(92,20)>
    <SetControlProperties "UIWaitBackground" position=(218,70) size=(92,20)>
    <SetControlProperties "VWall" position=(322,70) size=(92,20)>
    <AddText "Waiting" position=(10,100) font=10 size=(92,14)>
    <AddButton "West" position=(114,100) size=(92,20) text="str_west">

<End>
