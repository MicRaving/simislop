# Timer - Simitone EOD panel layout.
#
# Generated by Simitone.Client.UI.Panels.EODs.EODLayoutBuilder from the spec in
# EODLayouts.cs. Edit the spec, not this file: EODLayoutBuilderTests fails if the
# two disagree, so a hand edit here is a build failure rather than a silent drift.
#
# This is not an EA layout. The one the retail panel was written against is an
# artwork layout whose pictures live in a The Sims Online install, so the positions
# below are Simitone's own grid and the only picture any of these files names is
# the flat tile this port draws, uigraphics/eod/eod_placeholder.png.
#
# Captions come from Simitone's own string table (f900),
# so they are translatable rather than baked into this file.
#
# 12 controls, 3 rows, 4 columns.

<Begin>
    # Captions. f900 is Simitone's own UI string table
    # (Content/UI/uitext/<lang>.dir/_f900_simitone.cst), so these are
    # translatable rather than baked into this file.

    <Begin><SetSharedProperties stringDir = "UIText" stringTable = f900>
        <DefineString "str_countdown" stringIndex = 1049>
        <DefineString "str_minute_down" stringIndex = 1050>
        <DefineString "str_minute_up" stringIndex = 1051>
        <DefineString "str_pause" stringIndex = 1052>
        <DefineString "str_play" stringIndex = 1053>
        <DefineString "str_second_down" stringIndex = 1054>
        <DefineString "str_second_up" stringIndex = 1055>
        <DefineString "str_stopwatch" stringIndex = 1056>
    <End>

    # Pictures. A Texture2D property can only be filled by a DefineImage node, and
    # the retail layouts fill them with TSO artwork ids. Every panel that has one
    # gets the same flat tile instead: enough for a control that asks a texture for its
    # size or its graphics device, and visibly a placeholder rather than a lie.

    <DefineImage "img_Scrollbar" assetID="uigraphics/eod/eod_placeholder.png">

    <AddText "ColonStaticText" position=(10,10) font=10 size=(92,14)>
    <AddButton "CountdownButton" position=(114,10) size=(92,20) text="str_countdown">
    <AddButton "MinDownButton" position=(218,10) size=(92,20) text="str_minute_down">
    <AddTextEdit "MinTextEntry" position=(322,10) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddButton "MinUpButton" position=(10,40) size=(92,20) text="str_minute_up">
    <AddButton "PauseButton" position=(114,40) size=(92,20) text="str_pause">
    <AddButton "PlayButton" position=(218,40) size=(92,20) text="str_play">
    <AddButton "SecDownButton" position=(322,40) size=(92,20) text="str_second_down">
    <AddTextEdit "SecTextEntry" position=(10,70) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddButton "SecUpButton" position=(114,70) size=(92,20) text="str_second_up">
    <AddButton "StopwatchButton" position=(218,70) size=(92,20) text="str_stopwatch">
    <SetControlProperties "SubpanelBackground" position=(322,70) size=(92,20)>

<End>
