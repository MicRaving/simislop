# Slot Machine - Simitone EOD panel layout.
#
# Generated by Simitone.Client.UI.Panels.EODs.EODLayoutBuilder from the spec in
# EODLayouts.cs. Edit the spec, not this file: EODLayoutBuilderTests fails if the
# two disagree, so a hand edit here is a build failure rather than a silent drift.
#
# This is not an EA layout. The one the retail panel was written against is an
# artwork layout whose pictures live in a The Sims Online install, so the positions
# below are Simitone's own grid and the only picture any of these files names is
# the flat tile this port draws, uigraphics/eod/eod_placeholder.png.
#
# Captions come from Simitone's own string table (f900),
# so they are translatable rather than baked into this file.
#
# 43 controls, 11 rows, 4 columns.

<Begin>
    # Captions. f900 is Simitone's own UI string table
    # (Content/UI/uitext/<lang>.dir/_f900_simitone.cst), so these are
    # translatable rather than baked into this file.

    <Begin><SetSharedProperties stringDir = "UIText" stringTable = f900>
        <DefineString "str_arm" stringIndex = 1034>
        <DefineString "str_cash_out" stringIndex = 1035>
        <DefineString "str_house" stringIndex = 1036>
        <DefineString "str_odds" stringIndex = 1037>
        <DefineString "str_power" stringIndex = 1038>
        <DefineString "str_player" stringIndex = 1039>
        <DefineString "str_spin" stringIndex = 1040>
        <DefineString "str_less_bet" stringIndex = 1041>
        <DefineString "str_more_bet" stringIndex = 1042>
    <End>

    # Pictures. A Texture2D property can only be filled by a DefineImage node, and
    # the retail layouts fill them with TSO artwork ids. Every panel that has one
    # gets the same flat tile instead: enough for a control that asks a texture for its
    # size or its graphics device, and visibly a placeholder rather than a lie.

    <DefineImage "img_Wheel1Image" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_Wheel2Image" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_Wheel3Image" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_MoneyChipsImage" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_LightsFrame1Image" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_LightsFrame2Image" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_Wheel1LegendImage" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_Wheel2LegendImage" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_Wheel3LegendImage" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_Scrollbar" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_SliderTrack" assetID="uigraphics/eod/eod_placeholder.png">

    <AddButton "ArmButton" position=(10,10) size=(92,20) text="str_arm">
    <SetControlProperties "BetIndents" position=(114,10) size=(92,20)>
    <AddTextEdit "BetText" position=(218,10) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <SetControlProperties "ButtonSeat" position=(322,10) size=(24,24)>
    <AddButton "CashOutButton" position=(10,40) size=(92,20) text="str_cash_out">
    <AddTextEdit "CashText" position=(114,40) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <SetControlProperties "Chips" position=(218,40) size=(92,20)>
    <AddTextEdit "CurrentOdds" position=(322,40) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddText "House" position=(10,70) font=10 size=(92,14) text="str_house">
    <SetControlProperties "LightsFrame1" position=(114,70) size=(92,20)>
    <SetControlProperties "LightsFrame2" position=(218,70) size=(92,20)>
    <AddText "Loading" position=(322,70) font=10 size=(92,14)>
    <AddText "Odds" position=(10,100) font=10 size=(92,14) text="str_odds">
    <AddSlider "OddsSlider" position=(114,100) size=(92,12) image="img_SliderTrack" minValue=0 maxValue=10 orientation=0>
    <AddText "OnOff" position=(218,100) font=10 size=(92,14) text="str_power">
    <AddButton "OnOffButton" position=(322,100) size=(92,20) text="str_power">
    <AddText "PayoutTable1" position=(10,130) font=10 size=(92,14)>
    <AddText "PayoutTable2" position=(114,130) font=10 size=(92,14)>
    <AddText "PayoutTable3" position=(218,130) font=10 size=(92,14)>
    <SetControlProperties "PayoutTableColumn1Row1" position=(322,130) size=(92,20)>
    <SetControlProperties "PayoutTableColumn1Row2" position=(10,160) size=(92,20)>
    <SetControlProperties "PayoutTableColumn1Row3" position=(114,160) size=(92,20)>
    <SetControlProperties "PayoutTableColumn1Row4" position=(218,160) size=(92,20)>
    <SetControlProperties "PayoutTableColumn2Row1" position=(322,160) size=(92,20)>
    <SetControlProperties "PayoutTableColumn2Row2" position=(10,190) size=(92,20)>
    <SetControlProperties "PayoutTableColumn2Row3" position=(114,190) size=(92,20)>
    <SetControlProperties "PayoutTableColumn2Row4" position=(218,190) size=(92,20)>
    <AddTextEdit "PayoutText1" position=(322,190) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddTextEdit "PayoutText2" position=(10,220) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddTextEdit "PayoutText3" position=(114,220) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddTextEdit "PayoutText4" position=(218,220) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddTextEdit "PayoutText5" position=(322,220) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddTextEdit "PayoutText6" position=(10,250) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddTextEdit "PayoutText7" position=(114,250) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddTextEdit "PayoutText8" position=(218,250) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddText "Player" position=(322,250) font=10 size=(92,14) text="str_player">
    <AddButton "SpinButton" position=(10,280) size=(92,20) text="str_spin">
    <AddButton "SpinnerDecreaseBet" position=(114,280) size=(92,20) text="str_less_bet">
    <AddButton "SpinnerIncreaseBet" position=(218,280) size=(92,20) text="str_more_bet">
    <SetControlProperties "TextBack" position=(322,280) size=(24,24)>
    <SetControlProperties "WheelsBack" position=(10,310) size=(92,20)>
    <SetControlProperties "Wheelsback" position=(114,310) size=(24,24)>
    <SetControlProperties "WinningLine" position=(218,310) size=(92,20)>

<End>
