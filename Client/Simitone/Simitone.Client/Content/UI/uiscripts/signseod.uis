# Sign - Simitone EOD panel layout.
#
# Generated by Simitone.Client.UI.Panels.EODs.EODLayoutBuilder from the spec in
# EODLayouts.cs. Edit the spec, not this file: EODLayoutBuilderTests fails if the
# two disagree, so a hand edit here is a build failure rather than a silent drift.
#
# This is not an EA layout. The one the retail panel was written against is an
# artwork layout whose pictures live in a The Sims Online install, so the positions
# below are Simitone's own grid and the only picture any of these files names is
# the flat tile this port draws, uigraphics/eod/eod_placeholder.png.
#
# Captions come from Simitone's own string table (f900),
# so they are translatable rather than baked into this file.
#
# 23 controls, 6 rows, 4 columns.

<Begin>
    # Captions. f900 is Simitone's own UI string table
    # (Content/UI/uitext/<lang>.dir/_f900_simitone.cst), so these are
    # translatable rather than baked into this file.

    <Begin><SetSharedProperties stringDir = "UIText" stringTable = f900>
        <DefineString "str_friends_read" stringIndex = 1000>
        <DefineString "str_friends_write" stringIndex = 1001>
        <DefineString "str_permissions" stringIndex = 1002>
        <DefineString "str_write_text" stringIndex = 1003>
        <DefineString "str_roommates_read" stringIndex = 1004>
        <DefineString "str_roommates_write" stringIndex = 1005>
        <DefineString "str_friends" stringIndex = 1006>
        <DefineString "str_roommates" stringIndex = 1007>
        <DefineString "str_visitors" stringIndex = 1008>
        <DefineString "str_visitors_read" stringIndex = 1009>
        <DefineString "str_visitors_write" stringIndex = 1010>
    <End>

    # Pictures. A Texture2D property can only be filled by a DefineImage node, and
    # the retail layouts fill them with TSO artwork ids. Every panel that has one
    # gets the same flat tile instead: enough for a control that asks a texture for its
    # size or its graphics device, and visibly a placeholder rather than a lie.

    <DefineImage "img_Scrollbar" assetID="uigraphics/eod/eod_placeholder.png">

    <AddButton "FriendReadCheckButton" position=(10,10) size=(92,20) text="str_friends_read">
    <AddButton "FriendWriteCheckButton" position=(114,10) size=(92,20) text="str_friends_write">
    <AddButton "OwnerPermissionsButton" position=(218,10) size=(92,20) text="str_permissions">
    <SetControlProperties "OwnerPermissionsSubpanel" position=(322,10) size=(92,20)>
    <AddTextEdit "OwnerWriteTextBox" position=(10,40) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddButton "OwnerWriteTextButton" position=(114,40) size=(92,20) text="str_write_text">
    <SetControlProperties "OwnerWriteTextSubpanel" position=(218,40) size=(92,20)>
    <AddTextEdit "ReadTextBox" position=(322,40) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <SetControlProperties "ReadTextSubpanel" position=(10,70) size=(92,20)>
    <AddButton "RoommateReadCheckButton" position=(114,70) size=(92,20) text="str_roommates_read">
    <AddButton "RoommateWriteCheckButton" position=(218,70) size=(92,20) text="str_roommates_write">
    <AddText "TextRFriends" position=(322,70) font=10 size=(92,14) text="str_friends">
    <AddText "TextRRoommates" position=(10,100) font=10 size=(92,14) text="str_roommates">
    <AddText "TextRVisitors" position=(114,100) font=10 size=(92,14) text="str_visitors">
    <AddText "TextRead" position=(218,100) font=10 size=(92,14)>
    <AddText "TextWFriends" position=(322,100) font=10 size=(92,14) text="str_friends">
    <AddText "TextWRoommates" position=(10,130) font=10 size=(92,14) text="str_roommates">
    <AddText "TextWVisitors" position=(114,130) font=10 size=(92,14) text="str_visitors">
    <AddText "TextWrite" position=(218,130) font=10 size=(92,14)>
    <AddButton "VisitorReadCheckButton" position=(322,130) size=(92,20) text="str_visitors_read">
    <AddButton "VisitorWriteCheckButton" position=(10,160) size=(92,20) text="str_visitors_write">
    <AddTextEdit "WriteTextBox" position=(114,160) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <SetControlProperties "WriteTextSubpanel" position=(218,160) size=(92,20)>

<End>
