# Roulette - Simitone EOD panel layout.
#
# Generated by Simitone.Client.UI.Panels.EODs.EODLayoutBuilder from the spec in
# EODLayouts.cs. Edit the spec, not this file: EODLayoutBuilderTests fails if the
# two disagree, so a hand edit here is a build failure rather than a silent drift.
#
# This is not an EA layout. The one the retail panel was written against is an
# artwork layout whose pictures live in a The Sims Online install, so the positions
# below are Simitone's own grid and the only picture any of these files names is
# the flat tile this port draws, uigraphics/eod/eod_placeholder.png.
#
# Captions come from Simitone's own string table (f900),
# so they are translatable rather than baked into this file.
#
# 11 controls, 3 rows, 4 columns.

<Begin>
    # Captions. f900 is Simitone's own UI string table
    # (Content/UI/uitext/<lang>.dir/_f900_simitone.cst), so these are
    # translatable rather than baked into this file.

    <Begin><SetSharedProperties stringDir = "UIText" stringTable = f900>
        <DefineString "str_show_all_bets" stringIndex = 1077>
        <DefineString "str_number" stringIndex = 1078>
        <DefineString "str_total_bets" stringIndex = 1079>
    <End>

    # Pictures. A Texture2D property can only be filled by a DefineImage node, and
    # the retail layouts fill them with TSO artwork ids. Every panel that has one
    # gets the same flat tile instead: enough for a control that asks a texture for its
    # size or its graphics device, and visibly a placeholder rather than a lie.

    <DefineImage "img_imageChip_001" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imageChip_005" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imageChip_010" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imageChip_025" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imageChip_100" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imageChip_001_Btn" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imageChip_005_Btn" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imageChip_010_Btn" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imageChip_025_Btn" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imageChip_100_Btn" assetID="uigraphics/eod/eod_placeholder.png">

    <SetControlProperties "btnChip1" position=(10,10) size=(92,20)>
    <SetControlProperties "btnChip2" position=(114,10) size=(92,20)>
    <SetControlProperties "btnChip3" position=(218,10) size=(92,20)>
    <SetControlProperties "btnChip4" position=(322,10) size=(92,20)>
    <SetControlProperties "btnChip5" position=(10,40) size=(92,20)>
    <SetControlProperties "btnShowAllBets" position=(114,40) size=(92,20) text="str_show_all_bets">
    <AddText "labelNumber" position=(218,40) font=10 size=(92,14) text="str_number">
    <AddText "labelTotalBets" position=(322,40) font=10 size=(92,14) text="str_total_bets">
    <SetControlProperties "rouletteBall" position=(10,70) size=(92,20)>
    <SetControlProperties "rouletteTable" position=(114,70) size=(92,20)>
    <SetControlProperties "rouletteWheel" position=(218,70) size=(92,20)>

<End>
