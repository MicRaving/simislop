# Blackjack - Simitone EOD panel layout.
#
# Generated by Simitone.Client.UI.Panels.EODs.EODLayoutBuilder from the spec in
# EODLayouts.cs. Edit the spec, not this file: EODLayoutBuilderTests fails if the
# two disagree, so a hand edit here is a build failure rather than a silent drift.
#
# This is not an EA layout. The one the retail panel was written against is an
# artwork layout whose pictures live in a The Sims Online install, so the positions
# below are Simitone's own grid and the only picture any of these files names is
# the flat tile this port draws, uigraphics/eod/eod_placeholder.png.
#
# Captions come from Simitone's own string table (f900),
# so they are translatable rather than baked into this file.
#
# 27 controls, 7 rows, 4 columns.

<Begin>
    # Captions. f900 is Simitone's own UI string table
    # (Content/UI/uitext/<lang>.dir/_f900_simitone.cst), so these are
    # translatable rather than baked into this file.

    <Begin><SetSharedProperties stringDir = "UIText" stringTable = f900>
        <DefineString "str_bet" stringIndex = 1080>
        <DefineString "str_less_bet" stringIndex = 1041>
        <DefineString "str_more_bet" stringIndex = 1042>
        <DefineString "str_double" stringIndex = 1081>
        <DefineString "str_hit" stringIndex = 1082>
        <DefineString "str_split" stringIndex = 1083>
        <DefineString "str_stand" stringIndex = 1084>
    <End>

    # Pictures. A Texture2D property can only be filled by a DefineImage node, and
    # the retail layouts fill them with TSO artwork ids. Every panel that has one
    # gets the same flat tile instead: enough for a control that asks a texture for its
    # size or its graphics device, and visibly a placeholder rather than a lie.

    <DefineImage "img_imagePlayerBack" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imagePlayerBox" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imagePlayerBoxEdit" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imageBtnSeat" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_image_BetAmount" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_Scrollbar" assetID="uigraphics/eod/eod_placeholder.png">

    <AddTextEdit "TotalBetEntry" position=(10,10) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <SetControlProperties "betEntryBox" position=(114,10) size=(92,20)>
    <SetControlProperties "btnBet" position=(218,10) size=(92,20) text="str_bet">
    <AddButton "btnBetDown" position=(322,10) size=(92,20) text="str_less_bet">
    <AddButton "btnBetUp" position=(10,40) size=(92,20) text="str_more_bet">
    <SetControlProperties "btnChip1" position=(114,40) size=(92,20)>
    <SetControlProperties "btnChip2" position=(218,40) size=(92,20)>
    <SetControlProperties "btnChip3" position=(322,40) size=(92,20)>
    <SetControlProperties "btnChip4" position=(10,70) size=(92,20)>
    <SetControlProperties "btnChip5" position=(114,70) size=(92,20)>
    <SetControlProperties "btnDouble" position=(218,70) size=(92,20) text="str_double">
    <SetControlProperties "btnHit" position=(322,70) size=(92,20) text="str_hit">
    <SetControlProperties "btnSplit" position=(10,100) size=(92,20) text="str_split">
    <SetControlProperties "btnStand" position=(114,100) size=(92,20) text="str_stand">
    <SetControlProperties "dealerPos_Cards" position=(218,100) size=(92,20)>
    <SetControlProperties "dealerPos_Head" position=(322,100) size=(92,20)>
    <AddText "labelTotalBet" position=(10,130) font=10 size=(92,14)>
    <SetControlProperties "offset_ButtonSeat" position=(114,130) size=(92,20)>
    <SetControlProperties "offset_HandTotal" position=(218,130) size=(92,20)>
    <SetControlProperties "offset_PlayerSeat" position=(322,130) size=(92,20)>
    <SetControlProperties "playerOffset_Bet" position=(10,160) size=(92,20)>
    <SetControlProperties "playerOffset_Cards" position=(114,160) size=(92,20)>
    <SetControlProperties "playerOffset_Head" position=(218,160) size=(92,20)>
    <SetControlProperties "playerPos1" position=(322,160) size=(92,20)>
    <SetControlProperties "playerPos2" position=(10,190) size=(92,20)>
    <SetControlProperties "playerPos3" position=(114,190) size=(92,20)>
    <SetControlProperties "playerPos4" position=(218,190) size=(92,20)>

<End>
