# Pizza Maker - Simitone EOD panel layout.
#
# Generated by Simitone.Client.UI.Panels.EODs.EODLayoutBuilder from the spec in
# EODLayouts.cs. Edit the spec, not this file: EODLayoutBuilderTests fails if the
# two disagree, so a hand edit here is a build failure rather than a silent drift.
#
# This is not an EA layout. The one the retail panel was written against is an
# artwork layout whose pictures live in a The Sims Online install, so the positions
# below are Simitone's own grid and the only picture any of these files names is
# the flat tile this port draws, uigraphics/eod/eod_placeholder.png.
#
# Captions come from Simitone's own string table (f900),
# so they are translatable rather than baked into this file.
#
# 13 controls, 4 rows, 4 columns.

<Begin>
    # Captions. f900 is Simitone's own UI string table
    # (Content/UI/uitext/<lang>.dir/_f900_simitone.cst), so these are
    # translatable rather than baked into this file.

    <Begin><SetSharedProperties stringDir = "UIText" stringTable = f900>
        <DefineString "str_add_topping" stringIndex = 1012>
    <End>

    # Pictures. A Texture2D property can only be filled by a DefineImage node, and
    # the retail layouts fill them with TSO artwork ids. Every panel that has one
    # gets the same flat tile instead: enough for a control that asks a texture for its
    # size or its graphics device, and visibly a placeholder rather than a lie.

    <DefineImage "img_imageAnchovies" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imageCheese" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imageDough" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imageMushrooms" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imagePepperoni" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imageSauce" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_imagePlayer" assetID="uigraphics/eod/eod_placeholder.png">

    <SetControlProperties "UIBackground" position=(10,10) size=(92,20)>
    <SetControlProperties "background" position=(114,10) size=(92,20)>
    <AddButton "btnIngredient1" position=(218,10) size=(92,20) text="str_add_topping">
    <AddButton "btnIngredient2" position=(322,10) size=(92,20) text="str_add_topping">
    <AddButton "btnIngredient3" position=(10,40) size=(92,20) text="str_add_topping">
    <AddText "labelStation1" position=(114,40) font=10 size=(92,14)>
    <AddText "labelStation2" position=(218,40) font=10 size=(92,14)>
    <AddText "labelStation3" position=(322,40) font=10 size=(92,14)>
    <AddText "labelStation4" position=(10,70) font=10 size=(92,14)>
    <SetControlProperties "playerPos1" position=(114,70) size=(92,20)>
    <SetControlProperties "playerPos2" position=(218,70) size=(92,20)>
    <SetControlProperties "playerPos3" position=(322,70) size=(92,20)>
    <SetControlProperties "playerPos4" position=(10,100) size=(92,20)>

<End>
