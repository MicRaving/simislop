# War Game - Simitone EOD panel layout.
#
# Generated by Simitone.Client.UI.Panels.EODs.EODLayoutBuilder from the spec in
# EODLayouts.cs. Edit the spec, not this file: EODLayoutBuilderTests fails if the
# two disagree, so a hand edit here is a build failure rather than a silent drift.
#
# This is not an EA layout. The one the retail panel was written against is an
# artwork layout whose pictures live in a The Sims Online install, so the positions
# below are Simitone's own grid and the only picture any of these files names is
# the flat tile this port draws, uigraphics/eod/eod_placeholder.png.
#
# Captions come from Simitone's own string table (f900),
# so they are translatable rather than baked into this file.
#
# 24 controls, 6 rows, 4 columns.

<Begin>
    # Captions. f900 is Simitone's own UI string table
    # (Content/UI/uitext/<lang>.dir/_f900_simitone.cst), so these are
    # translatable rather than baked into this file.

    <Begin><SetSharedProperties stringDir = "UIText" stringTable = f900>
        <DefineString "str_artillery" stringIndex = 1044>
        <DefineString "str_cavalry" stringIndex = 1045>
        <DefineString "str_command" stringIndex = 1046>
        <DefineString "str_infantry" stringIndex = 1047>
        <DefineString "str_intel" stringIndex = 1048>
    <End>

    # Pictures. A Texture2D property can only be filled by a DefineImage node, and
    # the retail layouts fill them with TSO artwork ids. Every panel that has one
    # gets the same flat tile instead: enough for a control that asks a texture for its
    # size or its graphics device, and visibly a placeholder rather than a lie.

    <DefineImage "img_MoveIconImage" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_BlueProgressImage" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_RedProgressImage" assetID="uigraphics/eod/eod_placeholder.png">

    <SetControlProperties "ArtilleryButton" position=(10,10) size=(92,20) text="str_artillery">
    <SetControlProperties "BlueMoveBorder" position=(114,10) size=(92,20)>
    <SetControlProperties "BluePlayerPos" position=(218,10) size=(92,20)>
    <SetControlProperties "CavalryButton" position=(322,10) size=(92,20) text="str_cavalry">
    <SetControlProperties "CommandButton" position=(10,40) size=(92,20) text="str_command">
    <SetControlProperties "DefeatArtilleryPos" position=(114,40) size=(92,20)>
    <SetControlProperties "DefeatCavalryPos" position=(218,40) size=(92,20)>
    <SetControlProperties "DefeatCommandPos" position=(322,40) size=(92,20)>
    <SetControlProperties "DefeatInfantryPos" position=(10,70) size=(92,20)>
    <SetControlProperties "DefeatIntelPos" position=(114,70) size=(92,20)>
    <SetControlProperties "InfantryButton" position=(218,70) size=(92,20) text="str_infantry">
    <SetControlProperties "IntelButton" position=(322,70) size=(92,20) text="str_intel">
    <SetControlProperties "MoveSelectionBkgnd" position=(10,100) size=(92,20)>
    <SetControlProperties "ProgPosition1" position=(114,100) size=(92,20)>
    <SetControlProperties "ProgPosition2" position=(218,100) size=(92,20)>
    <SetControlProperties "ProgPosition3" position=(322,100) size=(92,20)>
    <SetControlProperties "ProgPosition4" position=(10,130) size=(92,20)>
    <SetControlProperties "ProgPosition5" position=(114,130) size=(92,20)>
    <SetControlProperties "ProgPosition6" position=(218,130) size=(92,20)>
    <SetControlProperties "RedMoveBorder" position=(322,130) size=(92,20)>
    <SetControlProperties "RedPlayerPos" position=(10,160) size=(92,20)>
    <SetControlProperties "ResultDefeatImg" position=(114,160) size=(92,20)>
    <SetControlProperties "ResultVictoryImg" position=(218,160) size=(92,20)>
    <SetControlProperties "ResultsBkgnd" position=(322,160) size=(92,20)>

<End>
