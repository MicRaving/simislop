# Game Comp: Draw A Card - Simitone EOD panel layout.
#
# Generated by Simitone.Client.UI.Panels.EODs.EODLayoutBuilder from the spec in
# EODLayouts.cs. Edit the spec, not this file: EODLayoutBuilderTests fails if the
# two disagree, so a hand edit here is a build failure rather than a silent drift.
#
# This is not an EA layout. The one the retail panel was written against is an
# artwork layout whose pictures live in a The Sims Online install, so the positions
# below are Simitone's own grid and the only picture any of these files names is
# the flat tile this port draws, uigraphics/eod/eod_placeholder.png.
#
# Captions come from Simitone's own string table (f900),
# so they are translatable rather than baked into this file.
#
# 28 controls, 7 rows, 4 columns.

<Begin>
    # Captions. f900 is Simitone's own UI string table
    # (Content/UI/uitext/<lang>.dir/_f900_simitone.cst), so these are
    # translatable rather than baked into this file.

    <Begin><SetSharedProperties stringDir = "UIText" stringTable = f900>
        <DefineString "str_delete" stringIndex = 1057>
        <DefineString "str_edit_card" stringIndex = 1058>
        <DefineString "str_next" stringIndex = 1059>
        <DefineString "str_previous" stringIndex = 1060>
        <DefineString "str_edit_game" stringIndex = 1061>
        <DefineString "str_new_card" stringIndex = 1062>
        <DefineString "str_save" stringIndex = 1063>
        <DefineString "str_one_fewer_card" stringIndex = 1064>
        <DefineString "str_one_more_card" stringIndex = 1065>
    <End>

    # Pictures. A Texture2D property can only be filled by a DefineImage node, and
    # the retail layouts fill them with TSO artwork ids. Every panel that has one
    # gets the same flat tile instead: enough for a control that asks a texture for its
    # size or its graphics device, and visibly a placeholder rather than a lie.

    <DefineImage "img_ImagePanelDivider" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_Scrollbar" assetID="uigraphics/eod/eod_placeholder.png">

    <AddTextEdit "BetterLabel" position=(10,10) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddButton "DeleteBtn" position=(114,10) size=(92,20) text="str_delete">
    <AddText "DrawChancesText" position=(218,10) font=10 size=(92,14)>
    <SetControlProperties "EditCardBack" position=(322,10) size=(92,20)>
    <AddButton "EditCardBtn" position=(10,40) size=(92,20) text="str_edit_card">
    <AddButton "EditCardNextBtn" position=(114,40) size=(92,20) text="str_next">
    <AddButton "EditCardPrevBtn" position=(218,40) size=(92,20) text="str_previous">
    <AddTextEdit "EditCardTextEdit" position=(322,40) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddButton "EditGameBtn" position=(10,70) size=(92,20) text="str_edit_game">
    <SetControlProperties "ManageGameBack" position=(114,70) size=(92,20)>
    <AddTextEdit "ManageGameDescripTextEdit" position=(218,70) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddTextEdit "ManageGameTitleTextEdit" position=(322,70) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <SetControlProperties "NewCardBack" position=(10,100) size=(92,20)>
    <AddButton "NewCardBtn" position=(114,100) size=(92,20) text="str_new_card">
    <AddTextEdit "NewCardTextEdit" position=(218,100) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddText "NumCardsText" position=(322,100) font=10 size=(92,14)>
    <AddTextEdit "NumCardsTextEdit" position=(10,130) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddTextEdit "NumDrawChancesTextEdit" position=(114,130) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddButton "SaveBtn" position=(218,130) size=(92,20) text="str_save">
    <SetControlProperties "SelectCardBack" position=(322,130) size=(92,20)>
    <AddListBox "SelectCardList" position=(10,160) font=9 size=(92,72) rowHeight=14 scrollbarImage="img_Scrollbar">
    <AddText "SelectCardText" position=(114,160) font=10 size=(92,14)>
    <AddButton "SpinnerMinusBtn" position=(218,160) size=(92,20) text="str_one_fewer_card">
    <AddButton "SpinnerPlusBtn" position=(322,160) size=(92,20) text="str_one_more_card">
    <AddText "UniqueCardsText" position=(10,190) font=10 size=(92,14)>
    <AddTextEdit "UniqueCardsTextEdit" position=(114,190) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <SetControlProperties "ViewDrawInfoBack" position=(218,190) size=(92,20)>
    <AddTextEdit "ViewDrawInfoTextEdit" position=(322,190) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">

<End>
