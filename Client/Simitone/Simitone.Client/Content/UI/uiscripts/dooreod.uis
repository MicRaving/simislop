# Permission Door - Simitone EOD panel layout.
#
# Generated by Simitone.Client.UI.Panels.EODs.EODLayoutBuilder from the spec in
# EODLayouts.cs. Edit the spec, not this file: EODLayoutBuilderTests fails if the
# two disagree, so a hand edit here is a build failure rather than a silent drift.
#
# This is not an EA layout. The one the retail panel was written against is an
# artwork layout whose pictures live in a The Sims Online install, so the positions
# below are Simitone's own grid and the only picture any of these files names is
# the flat tile this port draws, uigraphics/eod/eod_placeholder.png.
#
# Captions come from Simitone's own string table (f900),
# so they are translatable rather than baked into this file.
#
# 24 controls, 6 rows, 4 columns.

<Begin>
    # Captions. f900 is Simitone's own UI string table
    # (Content/UI/uitext/<lang>.dir/_f900_simitone.cst), so these are
    # translatable rather than baked into this file.

    <Begin><SetSharedProperties stringDir = "UIText" stringTable = f900>
        <DefineString "str_enter_code" stringIndex = 1028>
        <DefineString "str_employees" stringIndex = 1029>
        <DefineString "str_exempt" stringIndex = 1030>
        <DefineString "str_friends" stringIndex = 1006>
        <DefineString "str_lot_members" stringIndex = 1031>
        <DefineString "str_pay_to_enter" stringIndex = 1032>
        <DefineString "str_set_permissions" stringIndex = 1033>
        <DefineString "str_visitors" stringIndex = 1008>
    <End>

    # Pictures. A Texture2D property can only be filled by a DefineImage node, and
    # the retail layouts fill them with TSO artwork ids. Every panel that has one
    # gets the same flat tile instead: enough for a control that asks a texture for its
    # size or its graphics device, and visibly a placeholder rather than a lie.

    <DefineImage "img_Scrollbar" assetID="uigraphics/eod/eod_placeholder.png">

    <AddButton "CodeDoorButton" position=(10,10) size=(92,20) text="str_enter_code">
    <AddText "CodeDoorDirections" position=(114,10) font=10 size=(92,14)>
    <AddTextEdit "CodeTextEntry" position=(218,10) font=10 size=(92,18) capacity=72 scrollbarImage="img_Scrollbar">
    <AddText "DoorFee" position=(322,10) font=10 size=(92,14)>
    <AddText "Employees" position=(10,40) font=10 size=(92,14) text="str_employees">
    <AddText "Employees2" position=(114,40) font=10 size=(92,14) text="str_employees">
    <AddButton "Employees2CheckButton" position=(218,40) size=(92,20) text="str_employees">
    <AddButton "EmployeesCheckButton" position=(322,40) size=(92,20) text="str_employees">
    <SetControlProperties "EntryField" position=(10,70) size=(92,20)>
    <AddText "Exempt" position=(114,70) font=10 size=(92,14) text="str_exempt">
    <AddText "Friends" position=(218,70) font=10 size=(92,14) text="str_friends">
    <AddText "Friends2" position=(322,70) font=10 size=(92,14) text="str_friends">
    <AddButton "Friends2CheckButton" position=(10,100) size=(92,20) text="str_friends">
    <AddButton "FriendsCheckButton" position=(114,100) size=(92,20) text="str_friends">
    <AddText "Loading" position=(218,100) font=10 size=(92,14)>
    <AddText "LotMembers" position=(322,100) font=10 size=(92,14) text="str_lot_members">
    <AddButton "LotMembersCheckButton" position=(10,130) size=(92,20) text="str_lot_members">
    <AddButton "PayDoorButton" position=(114,130) size=(92,20) text="str_pay_to_enter">
    <AddButton "PermissionDoorButton" position=(218,130) size=(92,20) text="str_set_permissions">
    <AddText "PermissionDoorDirections" position=(322,130) font=10 size=(92,14)>
    <AddText "SimoleanSymbol" position=(10,160) font=10 size=(92,14)>
    <SetControlProperties "SubpanelBackground" position=(114,160) size=(92,20)>
    <AddText "Visitors" position=(218,160) font=10 size=(92,14) text="str_visitors">
    <AddButton "VisitorsCheckButton" position=(322,160) size=(92,20) text="str_visitors">

<End>
