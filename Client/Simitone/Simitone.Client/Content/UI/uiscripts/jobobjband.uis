# Band - Simitone EOD panel layout.
#
# Generated by Simitone.Client.UI.Panels.EODs.EODLayoutBuilder from the spec in
# EODLayouts.cs. Edit the spec, not this file: EODLayoutBuilderTests fails if the
# two disagree, so a hand edit here is a build failure rather than a silent drift.
#
# This is not an EA layout. The one the retail panel was written against is an
# artwork layout whose pictures live in a The Sims Online install, so the positions
# below are Simitone's own grid and the only picture any of these files names is
# the flat tile this port draws, uigraphics/eod/eod_placeholder.png.
#
# Captions come from Simitone's own string table (f900),
# so they are translatable rather than baked into this file.
#
# 29 controls, 8 rows, 4 columns.

<Begin>
    # Captions. f900 is Simitone's own UI string table
    # (Content/UI/uitext/<lang>.dir/_f900_simitone.cst), so these are
    # translatable rather than baked into this file.

    <Begin><SetSharedProperties stringDir = "UIText" stringTable = f900>
        <DefineString "str_buzz" stringIndex = 1066>
        <DefineString "str_sell_out" stringIndex = 1067>
        <DefineString "str_rock_on" stringIndex = 1068>
        <DefineString "str_do" stringIndex = 1069>
        <DefineString "str_do_high" stringIndex = 1070>
        <DefineString "str_fa" stringIndex = 1071>
        <DefineString "str_la" stringIndex = 1072>
        <DefineString "str_mi" stringIndex = 1073>
        <DefineString "str_re" stringIndex = 1074>
        <DefineString "str_so" stringIndex = 1075>
        <DefineString "str_ti" stringIndex = 1076>
    <End>

    # Pictures. A Texture2D property can only be filled by a DefineImage node, and
    # the retail layouts fill them with TSO artwork ids. Every panel that has one
    # gets the same flat tile instead: enough for a control that asks a texture for its
    # size or its graphics device, and visibly a placeholder rather than a lie.

    <DefineImage "img_PlayerImage" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_ContinueButtonImage" assetID="uigraphics/eod/eod_placeholder.png">
    <DefineImage "img_CashOutButtonImage" assetID="uigraphics/eod/eod_placeholder.png">

    <SetControlProperties "BUZZ" position=(10,10) size=(92,20) text="str_buzz">
    <SetControlProperties "ButtonBack" position=(114,10) size=(92,20)>
    <SetControlProperties "CASHOUT" position=(218,10) size=(92,20) text="str_sell_out">
    <SetControlProperties "CONTINUE" position=(322,10) size=(92,20) text="str_rock_on">
    <SetControlProperties "DOH" position=(10,40) size=(92,20) text="str_do">
    <SetControlProperties "DOH2" position=(114,40) size=(92,20) text="str_do_high">
    <SetControlProperties "FA" position=(218,40) size=(92,20) text="str_fa">
    <SetControlProperties "LA" position=(322,40) size=(92,20) text="str_la">
    <SetControlProperties "MI" position=(10,70) size=(92,20) text="str_mi">
    <SetControlProperties "Player1" position=(114,70) size=(92,20)>
    <AddText "Player1Wait" position=(218,70) font=10 size=(92,14)>
    <SetControlProperties "Player2" position=(322,70) size=(92,20)>
    <AddText "Player2Wait" position=(10,100) font=10 size=(92,14)>
    <SetControlProperties "Player3" position=(114,100) size=(92,20)>
    <AddText "Player3Wait" position=(218,100) font=10 size=(92,14)>
    <SetControlProperties "Player4" position=(322,100) size=(92,20)>
    <AddText "Player4Wait" position=(10,130) font=10 size=(92,14)>
    <SetControlProperties "Player5" position=(114,130) size=(92,20)>
    <SetControlProperties "Player6" position=(218,130) size=(92,20)>
    <SetControlProperties "Player7" position=(322,130) size=(92,20)>
    <SetControlProperties "Player8" position=(10,160) size=(92,20)>
    <SetControlProperties "RE" position=(114,160) size=(92,20) text="str_re">
    <SetControlProperties "SO" position=(218,160) size=(92,20) text="str_so">
    <SetControlProperties "TI" position=(322,160) size=(92,20) text="str_ti">
    <AddText "TextMessage" position=(10,190) font=10 size=(92,14)>
    <SetControlProperties "WaitPlayer1" position=(114,190) size=(92,20)>
    <SetControlProperties "WaitPlayer2" position=(218,190) size=(92,20)>
    <SetControlProperties "WaitPlayer3" position=(322,190) size=(92,20)>
    <SetControlProperties "WaitPlayer4" position=(10,220) size=(92,20)>

<End>
