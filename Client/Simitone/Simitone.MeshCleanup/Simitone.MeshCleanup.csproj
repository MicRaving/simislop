<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Single-sourced in Client/Simitone/Directory.Build.props, like Simitone.GenerateMeshes. -->
    <TargetFramework>$(SimitoneTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Simitone.MeshCleanup</RootNamespace>
    <AssemblyName>Simitone.MeshCleanup</AssemblyName>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same reference shape as Simitone.GenerateMeshes: the tool works on the FSO.Files
         formats and the generated pack, so it wants the client's resolved FSO + MonoGame +
         ImageSharp closure rather than its own copies of each version. -->
    <ProjectReference Include="..\Simitone.Client\Simitone.Client.csproj" />
  </ItemGroup>

</Project>
